GOOGLE_API_KEY=your-gemini-key
# Optional (defaults shown in comments)
# PAATTI_LLM_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# PAATTI_LLM_STRATEGY=round_robin     # or failover
# PAATTI_EMBEDDER=mpnet-ml            # bge-m3 needs ~3 GB RAM
# PAATTI_THINKING_LEVEL=low           # low | medium | high
# PAATTI_DEVICE=                      # cpu | mps | cuda (auto if empty)
# HF_TOKEN=                           # optional: faster model download
