GOOGLE_API_KEY=your-gemini-key
# Optional
PAATTI_LLM=gemini-3.5-flash-lite     # free tier: ~500 req/day (Flash models: ~20/day). Use gemini-3.8-flash with billing on
PAATTI_LLM_FALLBACK=                 # optional 2nd model used when the main one is overloaded (503)
PAATTI_LLM_RETRIES=4
PAATTI_LLM_RPM=0                     # client-side throttle (req/min); 9 keeps you under free-tier Flash-Lite                 # visible retries with backoff on 503/429
PAATTI_EMBEDDER=mpnet-ml             # tied best in benchmark, fits Streamlit Cloud's RAM | bge-m3 (needs ~3 GB RAM) | none = keyword only
PAATTI_BM25_WEIGHT=0                 # keyword weight in fusion; 0 = dense only (best in benchmark)
PAATTI_DEVICE=                       # cpu | mps | cuda (auto if empty)
PAATTI_THINKING_LEVEL=low            # low | medium | high (Gemini 3+)
# Streamlit only: point at the hosted API (leave empty to run the engine in-process)
API_URL=
HF_TOKEN=
